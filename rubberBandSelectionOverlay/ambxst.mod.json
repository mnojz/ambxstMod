{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "mnojz.dragoverlay",
  "name": "Rubber Band Selection Overlay",
  "version": "1.1.0",
  "author": "Manoj Joshi",
  "description": "Ambxst mod for creating a rubber band selection overlay for spawning terminals over the desktop",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <2.0.0"
  },
  "settings": {
    "schema": "settings.json"
  },
  "operations": [
    {
      "type": "overlay",
      "source": "payload/DragOverlay.qml",
      "target": "mods/mnojz.dragoverlay/payload/DragOverlay.qml"
    },
    {
      "type": "patch",
      "source": "patches/DragOverlay.patch"
    }
  ]
}