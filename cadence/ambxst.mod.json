{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "mnojz.cadence",
  "name": "Ambxst Cadence",
  "version": "4.1.3",
  "description": "Staged startup and reload, smoother fullscreen transitions, and themed farewells for power off and reboot. Adds Wi-Fi and Bluetooth controls, connected-device battery levels, and update notifications to Ambxst.",
  "license": "MIT",
  "author": "mnojz",
  "authorUrl": "https://github.com/mnojz",
  "homepage": "https://github.com/mnojz/ambxstMod/tree/main/cadence",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.15 <2.0.0",
    "testedBaseCommits": [
      "a3b5d977591c4eca2e48868c9f0ac04c63a3a23e"
    ]
  },
  "dependencies": [],
  "conflicts": [
    "drpezzer.roadie",
    "drpezzer.clean-load",
    "drpezzer.multi-monitor-fixes",
    "drpezzer.mod-updater",
    "drpezzer.settings-float",
    "drpezzer.bar-glance"
  ],
  "commands": [
    "setsid",
    "nmcli",
    "pgrep"
  ],
  "permissions": [
    "Spawns a small detached helper (the veil) that draws the wallpaper and frame while the shell restarts",
    "Runs `ambxst reload`, and the power menu's reboot or power off command, when you ask for them",
    "On Hyprland, retunes the window animation with `hyprctl eval` during a transition, then restores it",
    "Shows a desktop notification when Ambxst finds new mod versions",
    "Controls Bluetooth adapters and devices (BlueZ)",
    "At shell start, ends orphaned nmcli monitor processes from an earlier Ambxst daemon",
    "Launches blueman-manager from the Bluetooth widget",
    "Adds the bar.systrayExclude config key",
    "Keeps its options in ~/.config/ambxst/mods/mnojz.cadence.json and small state files in ~/.local/state/ambxst and ~/.cache/ambxst",
    "Lists Wi-Fi, IP details, saved profiles and VPNs using NetworkManager. Changes connections or opens nm-connection-editor on request."
  ],
  "operations": [
