{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "mnojz.lockscreen-customizer",
  "name": "Lock Screen Customizer",
  "version": "1.11.0",
  "description": "Adds lock screen customization for wallpapers, clock, media player, login, and an audio visualizer.",
  "author": "mnojz",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.15 <=1.4.1",
    "testedBaseCommits": [
      "a3b5d977591c4eca2e48868c9f0ac04c63a3a23e",
      "5db90ba000713b5cb991a2abce1b766ab47fbd2b"
    ]
  },
  "permissions": [
    "Scans the desktop and lock screen wallpaper folders and copies selected imports to the lock screen wallpaper library.",
    "Uses FFmpeg when available to generate video thumbnails.",
    "Analyzes the default playback monitor locally while a live audio visualizer is shown.",
    "Saves appearance and layout settings in the user’s lockscreen-customizer.json, independently of shell presets.",
    "Runs the power or display action you confirm from a configured button on the lock screen."
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/CustomLockWallpaper.qml",
      "target": "modules/lockscreen/CustomLockWallpaper.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenEditorHandle.qml",
      "target": "modules/lockscreen/LockscreenEditorHandle.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenPlacement.js",
      "target": "modules/lockscreen/LockscreenPlacement.js"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenPreviewWindow.qml",
      "target": "modules/lockscreen/LockscreenPreviewWindow.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenScene.qml",
      "target": "modules/lockscreen/LockscreenScene.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/widgets/dashboard/controls/LockscreenPanel.qml",
      "target": "modules/widgets/dashboard/controls/LockscreenPanel.qml"
    },
    {
      "type": "overlay",
      "source": "payload/scripts/lockscreen_wallpapers.py",
      "target": "scripts/lockscreen_wallpapers.py"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenClockFace.qml",
      "target": "modules/lockscreen/widgets/LockscreenClockFace.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenWidgetShadow.qml",
      "target": "modules/lockscreen/widgets/LockscreenWidgetShadow.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenPresets.js",
      "target": "modules/lockscreen/LockscreenPresets.js"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenClock.qml",
      "target": "modules/lockscreen/widgets/LockscreenClock.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenLogin.qml",
      "target": "modules/lockscreen/widgets/LockscreenLogin.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenMedia.qml",
      "target": "modules/lockscreen/widgets/LockscreenMedia.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/wallpaper-gaussian.frag.qsb",
      "target": "modules/lockscreen/wallpaper-gaussian.frag.qsb"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenSlide.qml",
      "target": "modules/lockscreen/LockscreenSlide.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenActions.js",
      "target": "modules/lockscreen/LockscreenActions.js"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenShortcut.qml",
      "target": "modules/lockscreen/widgets/LockscreenShortcut.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/CustomizedLockScreen.qml",
      "target": "modules/lockscreen/CustomizedLockScreen.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenVisualizer.qml",
      "target": "modules/lockscreen/widgets/LockscreenVisualizer.qml"
    },
    {
      "type": "overlay",
      "source": "payload/scripts/lockscreen_spectrum.py",
      "target": "scripts/lockscreen_spectrum.py"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenWallpaper.qml",
      "target": "modules/lockscreen/LockscreenWallpaper.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/qmldir",
      "target": "modules/lockscreen/widgets/qmldir"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/LockscreenSpectrum.qml",
      "target": "modules/lockscreen/widgets/LockscreenSpectrum.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/MediaButton.qml",
      "target": "modules/lockscreen/widgets/MediaButton.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/widgets/MediaPlayerSelector.qml",
      "target": "modules/lockscreen/widgets/MediaPlayerSelector.qml"
    },
    {
      "type": "patch",
      "source": "patches/lockscreen.patch"
    }
  ],
  "commands": [
    "python3",
    "systemctl",
    "ambxst"
  ]
}
