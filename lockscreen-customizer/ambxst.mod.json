{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "mnojz.lockscreen-customizer",
  "name": "Lock Screen Customizer",
  "version": "1.5.3",
  "description": "Adds a dedicated Ambxst Settings tab for lock screen wallpapers, clock, media player, and login appearance.",
  "author": "mnojz",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.15 <=1.4.1",
    "testedBaseCommits": [
      "a3b5d977591c4eca2e48868c9f0ac04c63a3a23e",
      "5db90ba000713b5cb991a2abce1b766ab47fbd2b"
    ]
  },
  "permissions": [
    "Scans the desktop and lock screen wallpaper folders and copies selected imports to the lock screen wallpaper library.",
    "Uses FFmpeg when available to generate video thumbnails.",
    "Saves appearance and layout settings in the user’s lockscreen-customizer.json, independently of shell presets.",
    "Runs the power or display action you confirm from a configured button on the lock screen."
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/CustomLockWallpaper.qml",
      "target": "modules/lockscreen/CustomLockWallpaper.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenEditorHandle.qml",
      "target": "modules/lockscreen/LockscreenEditorHandle.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenPlacement.js",
      "target": "modules/lockscreen/LockscreenPlacement.js"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenPreviewWindow.qml",
      "target": "modules/lockscreen/LockscreenPreviewWindow.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenScene.qml",
      "target": "modules/lockscreen/LockscreenScene.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/widgets/dashboard/controls/LockscreenPanel.qml",
      "target": "modules/widgets/dashboard/controls/LockscreenPanel.qml"
    },
    {
      "type": "overlay",
      "source": "payload/scripts/lockscreen_wallpapers.py",
      "target": "scripts/lockscreen_wallpapers.py"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenClock.qml",
      "target": "modules/lockscreen/LockscreenClock.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenLogin.qml",
      "target": "modules/lockscreen/LockscreenLogin.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenMedia.qml",
      "target": "modules/lockscreen/LockscreenMedia.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/wallpaper-gaussian.frag.qsb",
      "target": "modules/lockscreen/wallpaper-gaussian.frag.qsb"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenSlide.qml",
      "target": "modules/lockscreen/LockscreenSlide.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenActions.js",
      "target": "modules/lockscreen/LockscreenActions.js"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/LockscreenShortcut.qml",
      "target": "modules/lockscreen/LockscreenShortcut.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/lockscreen/CustomizedLockScreen.qml",
      "target": "modules/lockscreen/CustomizedLockScreen.qml"
    },
    {
      "type": "patch",
      "source": "patches/lockscreen.patch"
    }
  ],
  "commands": [
    "python3",
    "systemctl",
    "ambxst"
  ]
}
