+            property string mediaLayoutOptions: "{}"
+            property list<var> widgetPresetBaselines: []
+            property list<var> shortcuts: []
+        }
+    }
+
+    // Store custom lock screen preferences outside the shell preset's config directory.
+    property var customLockscreenData: null
+    readonly property var customLockscreen: customLockscreenData ?? lockscreen
+    property var pendingLockscreenWrite: null
+    property bool customLockscreenMissing: false
+
+    function migrateLockscreenSettings() {
+        if (customLockscreenMissing && lockscreenReady && customLockscreenData === null)
+            saveCustomLockscreen({});
+    }
+
+    onLockscreenReadyChanged: migrateLockscreenSettings()
+
+    function saveCustomLockscreen(changes) {
+        if (pendingLockscreenWrite !== null)
+            return false;
+        const values = {};
+        for (const key of Object.keys(LockscreenDefaults.data)) {
+            const value = changes[key] ?? customLockscreen[key];
+            values[key] = Array.isArray(LockscreenDefaults.data[key]) ? Array.from(value) : value;
+        }
+        pendingLockscreenWrite = values;
+        customLockscreenFile.setText(JSON.stringify(values, null, 2) + "\n");
+        return customLockscreenData === values;
+    }
+
+    FileView {
+        id: customLockscreenFile
+        path: root.configDir.slice(0, root.configDir.lastIndexOf("/")) + "/lockscreen-customizer.json"
+        atomicWrites: true
+        blockWrites: true
+        blockLoading: true
+        preload: true
+        printErrors: false
+
+        onLoaded: {
+            try {
+                root.customLockscreenData = ConfigValidator.validate(JSON.parse(text()), LockscreenDefaults.data);
+                root.customLockscreenMissing = false;
+            } catch (error) {
+                console.warn("Could not read Lock Screen Customizer settings:", error);
+            }
+        }
+
+        onLoadFailed: error => {
+            if (error === FileViewError.FileNotFound) {
+                root.customLockscreenMissing = true;
+                root.migrateLockscreenSettings();
+            }
+        }
+
+        onSaved: {
+            if (root.pendingLockscreenWrite !== null) {
+                root.customLockscreenData = root.pendingLockscreenWrite;
+                root.pendingLockscreenWrite = null;
+                root.customLockscreenMissing = false;
+            }
+        }
+
+        onSaveFailed: error => {
+            root.pendingLockscreenWrite = null;
+            console.warn("Could not save Lock Screen Customizer settings:", error);
         }
     }
 
